# Copy to .env and replace every placeholder before starting production.
POSTGRES_USER=bizwork_user
POSTGRES_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_DATABASE_PASSWORD
POSTGRES_DB=bizwork_db
SECRET_KEY=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32
DOMAIN=team.linkpc.net
CORS_ORIGINS=https://team.linkpc.net
# Optional first-run administrator provisioning:
ADMIN_INIT_USERNAME=admin
ADMIN_INIT_EMAIL=admin@example.com
# Set ADMIN_INIT_PASSWORD in the deployment environment, or let seed.py prompt securely.

# Supabase Free - server only; never expose the service role key in browser code.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=CHANGE_ME

# Google Sheets/Drive service account JSON, minified on one line.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_SHEET_ID=

# AI provider keys; server only. Gemini is the default provider.
GEMINI_API_KEY=
OPENAI_API_KEY=

# Next.js ERP bootstrap, only used when the users table is empty.
TEAMSPIRIT_ADMIN_EMAIL=
TEAMSPIRIT_ADMIN_PASSWORD=
TEAMSPIRIT_DEMO_DATA=false
# Set TEAMSPIRIT_DATA_DIR to a persistent directory on the Node.js host.
