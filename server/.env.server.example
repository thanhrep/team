# Copy to server/.env.server on the server PC. Never commit the real file.
DATABASE_URL=postgresql+psycopg2://bizwork_user:CHANGE_THIS_PASSWORD@127.0.0.1:5432/bizwork_db
SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
ADMIN_INIT_USERNAME=admin
ADMIN_INIT_EMAIL=admin@example.com
ADMIN_INIT_PASSWORD=REPLACE_WITH_A_LONG_UNIQUE_PASSWORD
BIZWORK_AUTH_DISABLED=false
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:1b
# Optional only after DNS/Tunnel setup:
# CLOUDFLARED_TUNNEL_TOKEN=PASTE_TUNNEL_TOKEN_HERE
